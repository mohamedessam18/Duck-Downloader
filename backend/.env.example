# Duck Downloader Environment Configuration

# Directory to store downloads
# DUCK_STORAGE_DIR=./storage/downloads

# Public base URL for served files
# DUCK_PUBLIC_BASE_URL=http://localhost:8000

# Cookies Configuration for Restricted/Private Content (Instagram, Facebook, etc.)
# You can specify either:
# 1. A path to a cookies.txt file in Netscape/Mozilla format:
# DUCK_YTDLP_COOKIES=D:/path/to/cookies.txt
# 
# 2. Or, tell yt-dlp to extract cookies directly from an installed browser:
# DUCK_YTDLP_COOKIES=browser:chrome
# DUCK_YTDLP_COOKIES=browser:firefox
# DUCK_YTDLP_COOKIES=browser:edge
# DUCK_YTDLP_COOKIES=browser:opera
# DUCK_YTDLP_COOKIES=browser:safari
# DUCK_YTDLP_COOKIES=browser:brave
# DUCK_YTDLP_COOKIES=browser:vivaldi

# Max duration in seconds for a single download process
# DUCK_MAX_DOWNLOAD_SECONDS=1800

# Max concurrent download tasks allowed
# DUCK_MAX_CONCURRENT_DOWNLOADS=3

# AI vocal isolation / music removal worker URL
# DUCK_PROCESS_WORKER_URL=http://localhost:8001
# DUCK_MUSIC_REMOVAL_TIMEOUT_SECONDS=900
