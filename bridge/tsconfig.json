{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2023"],
    "types": ["node"],
    "strict": true,
    "outDir": "dist",
    "rootDir": "..",
    "sourceMap": true,
    "skipLibCheck": true
  },
  "include": ["src/**/*.ts", "../contracts/**/*.ts", "../engine/src/paths.ts"]
}
