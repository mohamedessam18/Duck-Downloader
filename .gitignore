# ── Signing ─────────────────────────────────────────────────────────────────
# Never commit these. key.properties holds the keystore passwords in plain
# text, and the keystore itself is the only thing proving this app is this app:
# leak it and someone else can publish updates as you, lose it and nobody can.
android/key.properties
*.jks
*.keystore

# ── macOS ───────────────────────────────────────────────────────────────────
.DS_Store

